{
  "name": "mini-crm-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Mini CRM REST API (Express, MongoDB, Mongoose, JWT)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
